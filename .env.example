# ================================
# 巡回計画AI 環境変数テンプレート
# このファイルを .env にコピーして値を設定すること
# .env は絶対にgitにコミットしないこと
#
# 全キーが任意: 未設定でも全機能がフォールバックで動作する（docs/DESIGN.md 4章）
# ================================

# Anthropic API（任意）
# 未設定時: AI機能はルールベース文章生成にフォールバック
ANTHROPIC_API_KEY=

# LLMモデル（ANTHROPIC_API_KEY設定時のみ使用）
LLM_MODEL=claude-haiku-4-5-20251001

# 移動時間プロバイダ: haversine（既定・オフライン） / osrm（公開デモ、要ネット）
DISTANCE_PROVIDER=haversine

# ログレベル（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO
