# ================================
# 巡回計画AI 環境変数テンプレート
# アプリはプロセスの環境変数のみを読む（.envファイルの自動読み込みは行っていない）。
# READMEの手順どおり、PowerShellなら $env:NAME = '値' の形で起動前に設定すること。
# 値を .env に書いた場合も絶対にgitへコミットしないこと
#
# デモにAPIキーは不要。任意の口コミ抽出には別途キーと入力データが必要。
# ================================

# Anthropic API（任意）
# アプリ本体の条件解釈・推薦理由は常にルールベースで、このキーを設定しても変わらない。
# 使用箇所は口コミからの人気商品抽出スクリプト（backend/scripts/extract_reputation.py）のみ
ANTHROPIC_API_KEY=

# LLMモデル（上記スクリプトがANTHROPIC_API_KEY設定時のみ使用）
LLM_MODEL=claude-haiku-4-5-20251001

# 移動時間プロバイダ: haversine（既定・オフライン） / osrm（公開デモ、要ネット）
DISTANCE_PROVIDER=haversine

# SQLite DBファイルのパス（未設定時はbackend/data.db）
# MICHI_DB_PATH=
