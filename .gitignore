# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
/lib/
/lib64/

# 仮想環境
.venv/
venv/
env/
ENV/

# 環境変数（絶対コミットしない）
.env
.env.local
.env.*.local

# データファイル（生データ・加工済みデータは基本git管理外）
# 注意: ディレクトリ丸ごと除外（data/raw/ 等）にすると、配下のファイルは
# 親ディレクトリごと無視されるため "!data/raw/foo.json" の再包含が効かない。
# そのため「ディレクトリ内容をワイルドカードで除外 + 個別ファイルを再包含」の形にする。
# シードデータ2点（stations_kinki.json, chunks.json）はgit管理に含め、
# それ以外（reviews/・list.xls・P35-18_GML/・wiki/ 等）は引き続き除外する。
data/raw/*
!data/raw/.gitkeep
!data/raw/stations_kinki.json

data/processed/*
!data/processed/.gitkeep
!data/processed/chunks.json

data/embeddings/
data/photos/
!data/.gitkeep

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# テスト・カバレッジ
.pytest_cache/
.coverage
htmlcov/
.tox/

# mypy
.mypy_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# ログ
*.log
logs/

# SQLite（ローカルDBはコミットしない）
*.db
*.db.*
*.db-journal
*.sqlite3

# Node.js（frontend用）
node_modules/
.next/
out/

# 第三者データの再配布許諾は確認中。公開・PrivateいずれのGit履歴にも追加しない。
data/raw/stations_kinki.json
data/processed/chunks.json
backend/scratch/
